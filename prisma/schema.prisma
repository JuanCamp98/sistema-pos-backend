// Archivo de esquema de Prisma
// Aca se definen las tablas de la base de datos y sus relaciones

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Roles disponibles para los usuarios del sistema
model Rol {
  id     String @id @default(uuid())
  nombre String @unique

  usuarios Usuario[]

  @@map("roles")
}

// Usuarios que pueden iniciar sesion en el sistema
model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  apellido      String
  dni            String   @unique
  email         String   @unique
  contrasena    String
  rolId         String   @map("rol_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  rol    Rol     @relation(fields: [rolId], references: [id])
  ventas Venta[]

  @@map("usuarios")
}

// Productos disponibles para la venta
model Producto {
  id             String   @id @default(uuid())
  nombre         String
  descripcion    String?
  imagen         String?
  precio         Decimal  @db.Decimal(10, 2)
  stock          Int      @default(0)
  stockReservado Int      @default(0) @map("stock_reservado")
  categoriaId    String   @map("categoria_id")
  tipoProductoId String   @map("tipo_producto_id")
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  detallesVenta    DetalleVenta[]
  movimientosStock MovimientoStock[]
  promociones     PromocionProducto[]
  categoriaRelacion Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  tipoProducto      TipoProducto @relation(fields: [tipoProductoId], references: [id], onDelete: Restrict)

  @@map("productos")
}

model Categoria {
  id          String     @id @default(uuid())
  nombre      String     @unique
  activo      Boolean    @default(true)
  creadoEn    DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  productos Producto[]

  @@map("categorias")
}

model TipoProducto {
  id          String     @id @default(uuid())
  nombre      String     @unique
  activo      Boolean    @default(true)
  creadoEn    DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  productos Producto[]

  @@map("tipos_producto")
}

enum TipoDescuento {
  PORCENTAJE
  IMPORTE
}

model Promocion {
  id             String        @id @default(uuid())
  titulo         String
  descripcion    String?
  tipoDescuento  TipoDescuento @map("tipo_descuento")
  valorDescuento Decimal       @map("valor_descuento") @db.Decimal(10, 2)
  fechaInicio    DateTime      @map("fecha_inicio")
  fechaFin       DateTime      @map("fecha_fin")
  activo         Boolean       @default(true)
  creadoEn       DateTime      @default(now()) @map("creado_en")
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en")

  productos  PromocionProducto[]
  categorias PromocionCategoria[]

  @@map("promociones")
}

model PromocionProducto {
  promocionId String @map("promocion_id")
  productoId  String @map("producto_id")

  promocion Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  producto  Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([promocionId, productoId])
  @@map("promociones_productos")
}

model PromocionCategoria {
  promocionId String @map("promocion_id")
  categoria   String

  promocion Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)

  @@id([promocionId, categoria])
  @@map("promociones_categorias")
}

// Estado actual de una venta en su ciclo de vida
enum EstadoVenta {
  PENDIENTE
  COBRADA
  EN_PREPARACION
  LISTA_PARA_RETIRAR
  RETIRADA
  CANCELADA
}

enum OrigenVenta {
  AUTOGESTION
  RAPIDA
}

// Registro de cada venta realizada
model Venta {
  id                String      @id @default(uuid())
  fecha             DateTime    @default(now())
  total             Decimal     @db.Decimal(10, 2)
  usuarioId         String?     @map("usuario_id")
  clienteNombre     String?     @map("cliente_nombre")
  clienteApellido   String?     @map("cliente_apellido")
  clienteDni        String?     @map("cliente_dni")
  clienteEmail      String?     @map("cliente_email")
  codigoComprobante String      @unique @map("codigo_comprobante")
  estado            EstadoVenta @default(PENDIENTE)
  origen            OrigenVenta @default(AUTOGESTION)
  metodoPago        String?     @map("metodo_pago")
  mpOrderId         String?     @unique @map("mp_order_id")
  mpOrderStatus     String?     @map("mp_order_status")
  mpQrData          String?     @map("mp_qr_data") @db.Text
  creadoEn          DateTime    @default(now()) @map("creado_en")
  actualizadoEn     DateTime    @updatedAt @map("actualizado_en")

  usuario  Usuario?       @relation(fields: [usuarioId], references: [id])
  detalles DetalleVenta[]

  @@map("ventas")
}

// Cada producto vendido dentro de una venta
model DetalleVenta {
  id             String  @id @default(uuid())
  ventaId        String  @map("venta_id")
  productoId     String  @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_venta")
}

// Tipo de movimiento de stock: entrada o salida
enum TipoMovimientoStock {
  ENTRADA
  SALIDA
}

// Motivo por el cual se genero el movimiento de stock
enum MotivoMovimientoStock {
  VENTA
  AJUSTE_MANUAL
  DEVOLUCION
}

// Historial de cada cambio de stock de un producto
model MovimientoStock {
  id           String                @id @default(uuid())
  productoId   String                @map("producto_id")
  tipo         TipoMovimientoStock
  motivo       MotivoMovimientoStock
  cantidad     Int
  referenciaId String?               @map("referencia_id")
  creadoEn     DateTime              @default(now()) @map("creado_en")

  producto Producto @relation(fields: [productoId], references: [id])

  @@map("movimientos_stock")
}

# Credenciales SMTP de Ethereal para desarrollo: https://ethereal.email/
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Sistema POS <no-reply@pos.local>"
# URL pública del frontend; se usa para enlaces de comprobantes y recuperación de contraseña.
FRONTEND_URL=http://localhost:5173
# Zona horaria comercial utilizada para validar fechas y turnos de retiro.
ZONA_HORARIA_NEGOCIO=America/Argentina/Buenos_Aires

# Piso de precio para los productos con descuento promocional (ARS).
PRECIO_MINIMO_PROMOCIONAL=100.00

# Credenciales de Mercado Pago QR.
MP_ACCESS_TOKEN=
MP_QR_EXTERNAL_POS_ID=

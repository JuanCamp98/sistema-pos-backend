# Cadena de conexion de PostgreSQL usada por Prisma.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/sistema_pos?schema=public

# Secreto para firmar los JWT. Usar un valor aleatorio largo (>= 32 caracteres)
# y distinto en cada entorno. Por ejemplo: openssl rand -hex 32
JWT_SECRET=

# Puerto HTTP del backend.
PORT=3000

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Origenes permitidos por CORS, separados por coma. Si se omite se usa FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173

# Credenciales SMTP de Ethereal para desarrollo: https://ethereal.email/
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Sistema POS <no-reply@pos.local>"
# URL pública del frontend; se usa para enlaces de comprobantes y recuperación de contraseña.
FRONTEND_URL=http://localhost:5173
# Zona horaria comercial utilizada para validar fechas y turnos de retiro.
ZONA_HORARIA_NEGOCIO=America/Argentina/Buenos_Aires

# Piso de precio para los productos con descuento promocional (ARS).
PRECIO_MINIMO_PROMOCIONAL=100.00

# Credenciales de Mercado Pago QR.
MP_ACCESS_TOKEN=
MP_QR_EXTERNAL_POS_ID=
MP_QR_POS_NAME=Sistema POS
# Secreto de firma de webhooks de Mercado Pago. Si esta definido, se exige la
# cabecera x-signature en POST /ventas/webhook/mercadopago.
MP_WEBHOOK_SECRET=

# Minutos que puede quedar pendiente una venta anonima antes de liberar su stock.
VENTA_PENDIENTE_TTL_MINUTOS=1440
# Cada cuantos minutos corre la limpieza de ventas anonimas vencidas.
VENTA_PENDIENTE_LIMPIEZA_MINUTOS=15

# Contrasenas iniciales del seed (no se usan si el usuario ya existe).
SEED_ADMIN_PASSWORD=
SEED_CAJERO_PASSWORD=

# Poner en "true" solo para desarrollo local: desactiva el rate limiting.
# En produccion se ignora y el limite siempre queda activo.
RATE_LIMIT_DISABLED=false
